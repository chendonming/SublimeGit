{
    // Path to the git executable; empty = auto-detect from PATH
    "git_path": "",
    // Seconds before a git subprocess is killed
    "git_timeout": 20,
    // Seconds before a network git subprocess (push / pull) is killed
    "git_network_timeout": 120,
    // Pull mode for the Changes panel's Pull action:
    // "rebase" -> git pull --rebase (default); "ff-only" -> refuses divergence
    "pull_mode": "rebase",
    // Commits loaded per page in the Git Timeline
    "log_page_size": 100,
    // Max commits listed by Git: File History
    "file_history_limit": 200
}
